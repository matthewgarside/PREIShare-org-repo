# Copy this file to .env.local and replace these placeholders with your values.
# These are examples only; do not put real credentials in this file.

# Public: Vite variables can be included in the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server overrides. If omitted, the server uses the public Vite values above.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# SERVER ONLY: privileged credential; do not prefix with VITE_ or expose to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
